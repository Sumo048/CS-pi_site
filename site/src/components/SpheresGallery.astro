---
// Spheres-environment rollouts: side-by-side clips, each side labelled with
// its method and outcome (read from the clip's final frame; see spheres.ts).
import Video from "./Video.astro";
import Outcome from "./Outcome.astro";
import { SPHERE_GROUPS, type Side } from "../data/spheres";
import manifest from "../data/media_manifest.json";

type Entry = { name: string; mp4: string; webm: string; poster: string; w?: number; h?: number };
const byName = (group: string) =>
  Object.fromEntries(((manifest.spheres as Record<string, Entry[]>)[group] ?? []).map((e) => [e.name, e]));
const word = (o: string) => (o === "safe" ? "collision-free" : "collides");
---

<div class="gallery wide">
  {
    SPHERE_GROUPS.map((g) => {
      const clips = byName(g.key);
      return (
        <>
          <h3>{g.title}</h3>
          <p class="small">{g.blurb}</p>
          <div class="grid3">
            {g.clips.map((c) => {
              const e = clips[c.name];
              if (!e) return null;
              return (
                <figure class="clip">
                  <div class="on-panel">
                    <Video src={e.mp4} webm={e.webm} poster={e.poster} w={e.w} h={e.h}
                      label={`Left: ${c.left.method}, ${word(c.left.outcome)}. Right: ${c.right.method}, ${word(c.right.outcome)}.`} />
                  </div>
                  <figcaption class="clip-cap">
                    {([["Left", c.left], ["Right", c.right]] as [string, Side][]).map(([side, s]) => (
                      <span class="side">
                        <span class="who">{side}: {s.method}</span>{" "}
                        <Outcome kind={s.outcome === "safe" ? "ok" : "bad"} text={word(s.outcome)} />
                      </span>
                    ))}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </>
      );
    })
  }
</div>

---
// Template Figure, with an optional light panel for white-background figures
// (dark mode only; see .on-panel in global.css) and a width variant.
interface Props {
  panel?: boolean;
  narrow?: boolean;
}
const { panel = false, narrow = false } = Astro.props;
---

<figure class:list={["fig", narrow ? "narrow" : "wide"]}>
  <div class:list={[panel && "on-panel"]}>
    <slot name="figure" />
  </div>
  <figcaption>
    <slot name="caption" />
  </figcaption>
</figure>

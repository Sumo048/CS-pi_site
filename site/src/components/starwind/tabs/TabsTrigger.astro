---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends Omit<HTMLAttributes<"button">, "type" | "id" | "role"> {
  value: string;
}

export const tabsTrigger = tv({
  // Underlined text tab (styled by .ctl in global.css) instead of a pill.
  base: "ctl whitespace-nowrap",
});

const { value, class: className, ...rest } = Astro.props;
---

<button
  class={tabsTrigger({ class: className })}
  data-slot="tabs-trigger"
  data-tabs-trigger
  data-value={value}
  data-state="inactive"
  role="tab"
  aria-selected="false"
  {...rest}
>
  <slot />
</button>
